! X colors.
! Generated by 'wal'
*foreground:        #f9d5d0
*background:        #180f0e
*.foreground:       #f9d5d0
*.background:       #180f0e
emacs*foreground:   #f9d5d0
emacs*background:   #180f0e
URxvt*foreground:   #f9d5d0
XTerm*foreground:   #f9d5d0
UXTerm*foreground:  #f9d5d0
URxvt*background:   [100]#180f0e
XTerm*background:   #180f0e
UXTerm*background:  #180f0e
URxvt*cursorColor:  #f1dedc
XTerm*cursorColor:  #f1dedc
UXTerm*cursorColor: #f1dedc
URxvt*borderColor:  [100]#180f0e

! Colors 0-15.
*.color0: #180f0e
*color0:  #180f0e
*.color1: #f4acb6
*color1:  #f4acb6
*.color2: #c1e3b7
*color2:  #c1e3b7
*.color3: #f2dfbe
*color3:  #f2dfbe
*.color4: #adc5f7
*color4:  #adc5f7
*.color5: #f7cfec
*color5:  #f7cfec
*.color6: #b1e0d9
*color6:  #b1e0d9
*.color7: #f8c2a8
*color7:  #f8c2a8
*.color8: #caaba7
*color8:  #caaba7
*.color9: #f6b7c0
*color9:  #f6b7c0
*.color10: #cae7c1
*color10:  #cae7c1
*.color11: #f4e3c7
*color11:  #f4e3c7
*.color12: #b8ccf8
*color12:  #b8ccf8
*.color13: #f8d5ef
*color13:  #f8d5ef
*.color14: #bce3de
*color14:  #bce3de
*.color15: #f9cab4
*color15:  #f9cab4

! Black color that will not be affected by bold highlighting.
*.color66: #180f0e
*color66:  #180f0e

! Xclock colors.
XClock*foreground: #f9d5d0
XClock*background: #180f0e
XClock*majorColor:  rgba:f9/ca/b4/ff
XClock*minorColor:  rgba:f9/ca/b4/ff
XClock*hourColor:   rgba:f9/ca/b4/ff
XClock*minuteColor: rgba:f9/ca/b4/ff
XClock*secondColor: rgba:f9/ca/b4/ff

! Set depth to make transparency work.
URxvt*depth: 32
