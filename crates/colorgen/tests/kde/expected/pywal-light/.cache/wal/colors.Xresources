! X colors.
! Generated by 'wal'
*foreground:        #303f4c
*background:        #f4f6fc
*.foreground:       #303f4c
*.background:       #f4f6fc
emacs*foreground:   #303f4c
emacs*background:   #f4f6fc
URxvt*foreground:   #303f4c
XTerm*foreground:   #303f4c
UXTerm*foreground:  #303f4c
URxvt*background:   [100]#f4f6fc
XTerm*background:   #f4f6fc
UXTerm*background:  #f4f6fc
URxvt*cursorColor:  #e0e3e8
XTerm*cursorColor:  #e0e3e8
UXTerm*cursorColor: #e0e3e8
URxvt*borderColor:  [100]#f4f6fc

! Colors 0-15.
*.color0: #f4f6fc
*color0:  #f4f6fc
*.color1: #b84844
*color1:  #b84844
*.color2: #5bb850
*color2:  #5bb850
*.color3: #cf9a50
*color3:  #cf9a50
*.color4: #3161c1
*color4:  #3161c1
*.color5: #cf4fa2
*color5:  #cf4fa2
*.color6: #54b4a1
*color6:  #54b4a1
*.color7: #cd6947
*color7:  #cd6947
*.color8: #505e6a
*color8:  #505e6a
*.color9: #9b3e3b
*color9:  #9b3e3b
*.color10: #4d9b46
*color10:  #4d9b46
*.color11: #ae8246
*color11:  #ae8246
*.color12: #2952a3
*color12:  #2952a3
*.color13: #ae4489
*color13:  #ae4489
*.color14: #479888
*color14:  #479888
*.color15: #ad593e
*color15:  #ad593e

! Black color that will not be affected by bold highlighting.
*.color66: #f4f6fc
*color66:  #f4f6fc

! Xclock colors.
XClock*foreground: #303f4c
XClock*background: #f4f6fc
XClock*majorColor:  rgba:ad/59/3e/ff
XClock*minorColor:  rgba:ad/59/3e/ff
XClock*hourColor:   rgba:ad/59/3e/ff
XClock*minuteColor: rgba:ad/59/3e/ff
XClock*secondColor: rgba:ad/59/3e/ff

! Set depth to make transparency work.
URxvt*depth: 32
