! X colors.
! Generated by 'wal'
*foreground:        #cedff0
*background:        #101417
*.foreground:       #cedff0
*.background:       #101417
emacs*foreground:   #cedff0
emacs*background:   #101417
URxvt*foreground:   #cedff0
XTerm*foreground:   #cedff0
UXTerm*foreground:  #cedff0
URxvt*background:   [100]#101417
XTerm*background:   #101417
UXTerm*background:  #101417
URxvt*cursorColor:  #e0e3e8
XTerm*cursorColor:  #e0e3e8
UXTerm*cursorColor: #e0e3e8
URxvt*borderColor:  [100]#101417

! Colors 0-15.
*.color0: #101417
*color0:  #101417
*.color1: #b2a8c3
*color1:  #b2a8c3
*.color2: #8eb1cf
*color2:  #8eb1cf
*.color3: #8cbade
*color3:  #8cbade
*.color4: #c0b8d3
*color4:  #c0b8d3
*.color5: #9cc0de
*color5:  #9cc0de
*.color6: #c6bade
*color6:  #c6bade
*.color7: #aac6de
*color7:  #aac6de
*.color8: #a6b5c3
*color8:  #a6b5c3
*.color9: #bcb3cb
*color9:  #bcb3cb
*.color10: #9dbbd5
*color10:  #9dbbd5
*.color11: #9bc3e3
*color11:  #9bc3e3
*.color12: #c8c1d8
*color12:  #c8c1d8
*.color13: #a9c8e3
*color13:  #a9c8e3
*.color14: #cdc2e2
*color14:  #cdc2e2
*.color15: #b5cde2
*color15:  #b5cde2

! Black color that will not be affected by bold highlighting.
*.color66: #101417
*color66:  #101417

! Xclock colors.
XClock*foreground: #cedff0
XClock*background: #101417
XClock*majorColor:  rgba:b5/cd/e2/ff
XClock*minorColor:  rgba:b5/cd/e2/ff
XClock*hourColor:   rgba:b5/cd/e2/ff
XClock*minuteColor: rgba:b5/cd/e2/ff
XClock*secondColor: rgba:b5/cd/e2/ff

! Set depth to make transparency work.
URxvt*depth: 32
