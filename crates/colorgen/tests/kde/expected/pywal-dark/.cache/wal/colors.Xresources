! X colors.
! Generated by 'wal'
*foreground:        #cedff0
*background:        #101417
*.foreground:       #cedff0
*.background:       #101417
emacs*foreground:   #cedff0
emacs*background:   #101417
URxvt*foreground:   #cedff0
XTerm*foreground:   #cedff0
UXTerm*foreground:  #cedff0
URxvt*background:   [100]#101417
XTerm*background:   #101417
UXTerm*background:  #101417
URxvt*cursorColor:  #e0e3e8
XTerm*cursorColor:  #e0e3e8
UXTerm*cursorColor: #e0e3e8
URxvt*borderColor:  [100]#101417

! Colors 0-15.
*.color0: #101417
*color0:  #101417
*.color1: #f3acb6
*color1:  #f3acb6
*.color2: #c1e4b7
*color2:  #c1e4b7
*.color3: #f1dfbe
*color3:  #f1dfbe
*.color4: #acc5f7
*color4:  #acc5f7
*.color5: #f6d0ec
*color5:  #f6d0ec
*.color6: #b0e0d9
*color6:  #b0e0d9
*.color7: #f7c2a8
*color7:  #f7c2a8
*.color8: #a6b5c3
*color8:  #a6b5c3
*.color9: #f5b7c0
*color9:  #f5b7c0
*.color10: #c9e7c1
*color10:  #c9e7c1
*.color11: #f2e3c7
*color11:  #f2e3c7
*.color12: #b7cdf8
*color12:  #b7cdf8
*.color13: #f7d6ef
*color13:  #f7d6ef
*.color14: #bbe4de
*color14:  #bbe4de
*.color15: #f8cab4
*color15:  #f8cab4

! Black color that will not be affected by bold highlighting.
*.color66: #101417
*color66:  #101417

! Xclock colors.
XClock*foreground: #cedff0
XClock*background: #101417
XClock*majorColor:  rgba:f8/ca/b4/ff
XClock*minorColor:  rgba:f8/ca/b4/ff
XClock*hourColor:   rgba:f8/ca/b4/ff
XClock*minuteColor: rgba:f8/ca/b4/ff
XClock*secondColor: rgba:f8/ca/b4/ff

! Set depth to make transparency work.
URxvt*depth: 32
