! X colors.
! Generated by 'wal'
*foreground:        #303f4c
*background:        #f4f6fc
*.foreground:       #303f4c
*.background:       #f4f6fc
emacs*foreground:   #303f4c
emacs*background:   #f4f6fc
URxvt*foreground:   #303f4c
XTerm*foreground:   #303f4c
UXTerm*foreground:  #303f4c
URxvt*background:   [100]#f4f6fc
XTerm*background:   #f4f6fc
UXTerm*background:  #f4f6fc
URxvt*cursorColor:  #e0e3e8
XTerm*cursorColor:  #e0e3e8
UXTerm*cursorColor: #e0e3e8
URxvt*borderColor:  [100]#f4f6fc

! Colors 0-15.
*.color0: #f4f6fc
*color0:  #f4f6fc
*.color1: #2c0e7d
*color1:  #2c0e7d
*.color2: #35108e
*color2:  #35108e
*.color3: #3912a0
*color3:  #3912a0
*.color4: #0a5189
*color4:  #0a5189
*.color5: #0c599b
*color5:  #0c599b
*.color6: #0d62ad
*color6:  #0d62ad
*.color7: #4180c7
*color7:  #4180c7
*.color8: #505e6a
*color8:  #505e6a
*.color9: #250f6a
*color9:  #250f6a
*.color10: #2c1179
*color10:  #2c1179
*.color11: #301388
*color11:  #301388
*.color12: #0a4475
*color12:  #0a4475
*.color13: #0c4c83
*color13:  #0c4c83
*.color14: #0d5392
*color14:  #0d5392
*.color15: #376da8
*color15:  #376da8

! Black color that will not be affected by bold highlighting.
*.color66: #f4f6fc
*color66:  #f4f6fc

! Xclock colors.
XClock*foreground: #303f4c
XClock*background: #f4f6fc
XClock*majorColor:  rgba:37/6d/a8/ff
XClock*minorColor:  rgba:37/6d/a8/ff
XClock*hourColor:   rgba:37/6d/a8/ff
XClock*minuteColor: rgba:37/6d/a8/ff
XClock*secondColor: rgba:37/6d/a8/ff

! Set depth to make transparency work.
URxvt*depth: 32
