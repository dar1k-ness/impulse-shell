en_US LC_ALL=en_US.UTF-8
ru_RU LC_ALL=ru_RU.UTF-8
de_DE LC_ALL=de_DE.UTF-8
sv_SE LC_ALL=sv_SE.UTF-8
tr_TR LC_ALL=tr_TR.UTF-8
ja_JP LC_ALL=ja_JP.UTF-8
zh_CN LC_ALL=zh_CN.UTF-8
zh_TW LC_ALL=zh_TW.UTF-8
es_ES LC_ALL=es_ES.UTF-8
unset
posix LANG=POSIX
unknown LC_ALL=xx_YY.UTF-8
no_territory LANG=sv
euro LANG=de_DE@euro
collate LC_COLLATE=sv_SE.UTF-8 LANG=en_US.UTF-8
numeric LC_NUMERIC=sv_SE.UTF-8 LANG=en_US.UTF-8
