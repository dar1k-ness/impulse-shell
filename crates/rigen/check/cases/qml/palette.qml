        l.push(step("own", () => { child.palette.button = "green"; item.palette.button = "yellow"; return four(item, "button") + " " + four(child, "button") + " " + four(grandchild, "button") }))
        // `undefined` in a colour takes the set one away.
        l.push(step("colour reset", () => { item.palette.button = undefined; return four(item, "button") + " " + four(child, "button") }))
        l.push(step("group colour reset", () => { item.palette.disabled.text = undefined; return four(item, "text") + " " + four(child, "text") }))
        l.push(step("group reset", () => { item.palette.active = undefined; return text(item.palette.active) + four(item, "base") }))
        // `palette = undefined` takes every set one away.
        l.push(step("set again", () => { item.palette.button = "red"; item.palette.inactive.mid = "#aabbcc"; return four(item, "button") + " " + four(item, "mid") }))
        l.push(step("reset", () => { item.palette = undefined; return text(item.palette) + four(item, "button") + " " + four(item, "mid") + " " + four(child, "button") + " " + four(grandchild, "mid") }))
        l.push(step("reset again", () => { item.palette = undefined; return four(item, "button") }))
        l.push(step("child reset", () => { child.palette = undefined; return four(child, "button") + " " + four(grandchild, "button") }))
        l.push(step("fresh reset", () => { off.palette = undefined; return text(off.palette) + four(off, "button") }))
        // The same in a control, a popup and the two windows.
        l.push(step("control", () => { button.palette.buttonText = "red"; return four(button, "buttonText") + " " + four(inButton, "buttonText") }))
        l.push(step("control reset", () => { button.palette = undefined; return text(button.palette) + four(button, "buttonText") + " " + four(inButton, "buttonText") }))
        l.push(step("pane", () => four(pane, "buttonText") + " " + four(inPane, "buttonText") + " " + four(deep, "buttonText")))
        l.push(step("pane reset", () => { pane.palette = undefined; return four(pane, "buttonText") + " " + four(deep, "buttonText") }))
        l.push(step("popup", () => { popup.palette.window = "red"; return four(popup, "window") + " " + four(inPopup, "window") + " " + four(buttonInPopup, "window") }))
        l.push(step("popup reset", () => { popup.palette = undefined; return text(popup.palette) + four(popup, "window") + " " + four(inPopup, "window") + " " + four(buttonInPopup, "window") }))
        l.push(step("popup colour reset", () => { popup.palette.window = undefined; return four(popup, "window") + " " + four(inPopup, "window") }))
        l.push(step("window", () => { win.palette.window = "red"; return four(win, "window") + " " + four(inWin, "window") + " " + four(buttonInWin, "window") }))
        l.push(step("window reset", () => { win.palette = undefined; return text(win.palette) + four(win, "window") + " " + four(inWin, "window") + " " + four(buttonInWin, "window") }))
        l.push(step("app", () => { app.palette.window = "red"; return four(app, "window") + " " + four(inApp, "window") + " " + four(buttonInApp, "window") + " " + four(popupInApp, "window") + " " + four(deepInApp, "window") }))
        l.push(step("app reset", () => { app.palette = undefined; return text(app.palette) + four(app, "window") + " " + four(inApp, "window") + " " + four(buttonInApp, "window") + " " + four(deepInApp, "window") }))
        // Moved under another item, an item has the colours set there.
        l.push(step("moved", () => { grandchild.parent = declared; return four(grandchild, "button") + " " + four(grandchild, "text") }))
        l.push(step("moved", () => { grandchild.parent = pane; pane.palette.button = "#212223"; return four(grandchild, "button") + " " + four(grandchild, "text") }))
        // Enabled or not, the palette's own colours are those of the group in use.
        l.push(step("enabled", () => { off.enabled = true; buttonOff.enabled = true; item.enabled = false; return four(off, "text") + " " + four(inOff, "text") + " " + four(buttonOff, "text") + " " + four(item, "text") + " " + four(child, "text") }))
        // Another palette written to the property gives the colours set in it; what is no palette does not.
        l.push(step("palette", () => { declared.palette.light = "#313233"; item.palette = declared.palette; return (item.palette === declared.palette) + four(item, "button") + " " + four(item, "text") + " " + four(item, "light") }))
        l.push(step("default palette", () => { item.palette = button.palette; return four(item, "button") + " " + four(item, "buttonText") }))
        l.push(step("null", () => { item.palette = null; return text(item.palette) + four(item, "button") }))
        l.push(step("no colour", () => { item.palette.button = 5; return four(item, "button") }))
        l.push(step("no colour", () => { item.palette.button = "nocolor"; item.palette.mid = "#80112233"; return four(item, "button") + " " + four(item, "mid") }))
        // What is set in every group and then in one.
        l.push(step("every", () => { button.palette.button = "red"; button.palette.disabled.button = "blue"; return four(button, "button") }))
        l.push(step("every reset", () => { button.palette.button = undefined; return four(button, "button") }))
        l.push(step("one", () => { button.palette.disabled.button = "blue"; button.palette.button = "red"; return four(button, "button") }))
        l.push(step("one reset", () => { button.palette.disabled.button = undefined; return four(button, "button") }))
        l.push(step("one same", () => { button.palette.active.button = "red"; return four(button, "button") }))
        l.push("a group given a colour " + (typeof fieldGroup.palette.active) + " " + (colours(fieldGroup) === colours(field)) + " " + four(fieldGroup, "dark") + " " + four(fieldGroup, "highlight"))
        l.push(step("as nothing set", () => { button.palette.text = "#353637"; return four(button, "text") }))
        // A popup has the colours set in its window; what is in the popup only those set in
        // an ApplicationWindow. A window has its own.
        l.push(step("in window", () => { win.palette.mid = "#414243"; app.palette.mid = "#414243"; return [popupInWin, deepInWin, inItemInWin, winInWin, popupInApp, deepInApp, winInApp, appInApp, popupInItem, windowInItem].map(o => four(o, "mid")).join(" ") }))
        // A popup in a window that is no ApplicationWindow has the colours set in the window
        // when the popup was made, and again once its own are written.
        l.push(step("made in window", () => four(popupInSet, "mid") + " " + four(deepInSet, "mid") + " " + four(popupInBound, "dark")))
        l.push(step("window later", () => { root.dark = "#717273"; winSet.palette.mid = "#818283"; winSet.palette.light = "#919293"; return four(popupInSet, "mid") + " " + four(popupInSet, "light") + " " + four(popupInBound, "dark") + " " + four(winBound, "dark") }))
        l.push(step("popup written", () => { popupInSet.palette.shadow = "#a1a2a3"; return four(popupInSet, "mid") + " " + four(popupInSet, "light") + " " + four(popupInSet, "shadow") }))
        l.push(step("window after", () => { winSet.palette.mid = "#b1b2b3"; return four(popupInSet, "mid") }))
        // A binding reads the colour there is now.
        l.push(step("bound", () => { var s = bound.color + ""; pane.palette.button = "#515253"; s += bound.color; bound.enabled = false; pane.palette.disabled.button = "#616263"; return s + bound.color }))
        result = l.join(" | ")
    }
}
