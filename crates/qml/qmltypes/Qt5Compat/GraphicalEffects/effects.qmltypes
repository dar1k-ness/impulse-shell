            type: "double"
        }
        Property {
            name: "verticalOffset"
            type: "double"
        }
        Property {
            name: "spread"
            type: "double"
        }
        Property {
            name: "cached"
            type: "bool"
        }
        Property {
            name: "transparentBorder"
            type: "bool"
        }
        Signal { name: "sourceChanged" }
        Signal { name: "radiusChanged" }
