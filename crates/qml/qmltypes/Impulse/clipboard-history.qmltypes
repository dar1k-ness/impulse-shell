import QtQuick.tooling 1.2

// The clipboard history kept by cliphist (or a stash-like tool), implemented natively by ri
// (crates/qml/src/ports/clip.rs). Not generated by qmltyperegistrar: there is no C++ behind it.
Module {
    Component {
        file: "clip.rs"
        name: "ImpulseClipboardHistory"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["Impulse/ClipboardHistory 1.0"]
        isCreatable: false
        isSingleton: true
        exportMetaObjectRevisions: [256]
        Property {
            name: "binary"
            type: "QString"
            read: "binary"
            write: "setBinary"
            notify: "binaryChanged"
            index: 0
        }
        Property {
            name: "pasteCommand"
            type: "QString"
            read: "pasteCommand"
            write: "setPasteCommand"
            notify: "pasteCommandChanged"
            index: 1
        }
        Property {
            name: "entries"
            type: "QStringList"
            read: "entries"
            notify: "entriesChanged"
            index: 2
            isReadonly: true
        }
        Signal { name: "binaryChanged" }
        Signal { name: "pasteCommandChanged" }
        Signal { name: "entriesChanged" }
        Signal {
            name: "imageDecoded"
            Parameter { name: "path"; type: "QString" }
            Parameter { name: "ok"; type: "bool" }
        }
        Method { name: "refresh" }
        Method { name: "watched"; type: "bool" }
        Method {
            name: "copy"
            Parameter { name: "entry"; type: "QString" }
        }
        Method {
            name: "superpaste"
            Parameter { name: "entries"; type: "QStringList" }
        }
        Method {
            name: "remove"
            Parameter { name: "entry"; type: "QString" }
        }
        Method { name: "wipe" }
        Method {
            name: "decodeImage"
            Parameter { name: "entry"; type: "QString" }
            Parameter { name: "path"; type: "QString" }
        }
        Method {
            name: "removeImage"
            Parameter { name: "path"; type: "QString" }
        }
    }
}
