import QtQuick.tooling 1.2

// A keyboard of the shell's own (zwp_virtual_keyboard_v1), implemented natively by ri
// (crates/qml/src/ports/vkbd.rs). Keycodes are Linux evdev codes. Not generated by
// qmltyperegistrar: there is no C++ behind it.
Module {
    Component {
        file: "vkbd.rs"
        name: "ImpulseKeySender"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["Impulse/KeySender 1.0"]
        isCreatable: false
        isSingleton: true
        exportMetaObjectRevisions: [256]
        Method {
            name: "press"
            Parameter { name: "keycode"; type: "int" }
        }
        Method {
            name: "release"
            Parameter { name: "keycode"; type: "int" }
        }
        Method { name: "releaseAll" }
    }
}
