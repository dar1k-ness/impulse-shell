import QtQuick.tooling 1.2

// Impulse/Keyring: the Secret Service over the session bus, implemented natively by ri
// (crates/qml/src/keyring.rs). Not generated by qmltyperegistrar: there is no C++ behind it.
Module {
    Component {
        file: "keyring.rs"
        name: "ImpulseKeyring"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["Impulse/Keyring 1.0"]
        isCreatable: false
        isSingleton: true
        exportMetaObjectRevisions: [256]
        Enum {
            name: "LookupResult"
            values: ["Found", "NotFound", "Locked"]
        }
        Enum {
            name: "UnlockResult"
            values: ["Unlocked", "AlreadyUnlocked", "Failed"]
        }
        Signal {
            name: "lookupFinished"
            Parameter { name: "result"; type: "int" }
            Parameter { name: "secret"; type: "QString" }
        }
        Signal {
            name: "unlockFinished"
            Parameter { name: "result"; type: "int" }
        }
        Method {
            name: "lookup"
            Parameter { name: "attributes"; type: "QVariantMap" }
            Parameter { name: "unlock"; type: "bool" }
        }
        Method {
            name: "store"
            Parameter { name: "label"; type: "QString" }
            Parameter { name: "attributes"; type: "QVariantMap" }
            Parameter { name: "secret"; type: "QString" }
        }
        Method {
            name: "unlock"
            Parameter { name: "password"; type: "QString" }
        }
    }
}
