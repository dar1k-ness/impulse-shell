import QtQuick.tooling 1.2

// Prints `dir`, `file` or `invalid` for `path`; exits 0 only for a directory.
// A Process whose work is native (crates/qml/src/procs.rs): `running`, `exited`, `stdout` as Process.
Module {
    Component {
        file: "procs.rs"
        name: "ImpulsePathKind"
        accessSemantics: "reference"
        prototype: "Process"
        exports: ["Impulse/PathKind 1.0"]
        exportMetaObjectRevisions: [256]
        Property {
            name: "path"
            type: "QString"
            read: "path"
            write: "setPath"
            notify: "pathChanged"
            index: 0
        }
        Signal { name: "pathChanged" }
    }
}
