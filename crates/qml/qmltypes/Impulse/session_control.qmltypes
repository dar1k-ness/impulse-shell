import QtQuick.tooling 1.2

// Impulse/SessionControl: the login session's power and lock actions, implemented natively by
// ri (crates/qml/src/session.rs). Not generated by qmltyperegistrar: there is no C++ behind it.
Module {
    Component {
        file: "session.rs"
        name: "ImpulseSessionControl"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["Impulse/SessionControl 1.0"]
        isCreatable: false
        isSingleton: true
        exportMetaObjectRevisions: [256]
        Method { name: "lock" }
        Method { name: "suspend" }
        Method { name: "hibernate" }
        Method { name: "poweroff" }
        Method { name: "reboot" }
        Method { name: "rebootToFirmware" }
        Method { name: "logout" }
        Method {
            name: "terminate"
            Parameter { name: "pid"; type: "int" }
        }
    }
}
