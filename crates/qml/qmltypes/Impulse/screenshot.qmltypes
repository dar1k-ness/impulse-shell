import QtQuick.tooling 1.2

// Screen capture, recording, the colour picker and the MangoHud FPS limit, implemented
// natively by ri (crates/qml/src/screenshot.rs). Not generated by qmltyperegistrar: there is
// no C++ behind them.
Module {
    Component {
        file: "screenshot.rs"
        name: "ImpulseScreenshot"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["Impulse/Screenshot 1.0"]
        isCreatable: false
        isSingleton: true
        exportMetaObjectRevisions: [256]
        Signal {
            name: "captured"
            Parameter { name: "path"; type: "QString" }
            Parameter { name: "ok"; type: "bool" }
        }
        Signal {
            name: "lightnessMeasured"
            Parameter { name: "output"; type: "QString" }
            Parameter { name: "lightness"; type: "double" }
        }
        Method {
            name: "capture"
            Parameter { name: "output"; type: "QString" }
            Parameter { name: "path"; type: "QString" }
        }
        Method { name: "discardCaptures" }
        Method {
            name: "copy"
            Parameter { name: "path"; type: "QString" }
            Parameter { name: "x"; type: "double" }
            Parameter { name: "y"; type: "double" }
            Parameter { name: "width"; type: "double" }
            Parameter { name: "height"; type: "double" }
            Parameter { name: "saveDir"; type: "QString" }
        }
        Method {
            name: "edit"
            Parameter { name: "path"; type: "QString" }
            Parameter { name: "x"; type: "double" }
            Parameter { name: "y"; type: "double" }
            Parameter { name: "width"; type: "double" }
            Parameter { name: "height"; type: "double" }
            Parameter { name: "tool"; type: "QString" }
        }
        Method {
            name: "search"
            Parameter { name: "path"; type: "QString" }
            Parameter { name: "x"; type: "double" }
            Parameter { name: "y"; type: "double" }
            Parameter { name: "width"; type: "double" }
            Parameter { name: "height"; type: "double" }
            Parameter { name: "uploadEndpoint"; type: "QString" }
            Parameter { name: "searchBaseUrl"; type: "QString" }
        }
        Method {
            name: "recognizeText"
            Parameter { name: "path"; type: "QString" }
            Parameter { name: "x"; type: "double" }
            Parameter { name: "y"; type: "double" }
            Parameter { name: "width"; type: "double" }
            Parameter { name: "height"; type: "double" }
        }
        Method { name: "copyScreen" }
        Method {
            name: "measureLightness"
            Parameter { name: "output"; type: "QString" }
        }
    }
    Component {
        file: "screenshot.rs"
        name: "ImpulseScreenRecorder"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["Impulse/ScreenRecorder 1.0"]
        isCreatable: false
        isSingleton: true
        exportMetaObjectRevisions: [256]
        Signal {
            name: "checked"
            Parameter { name: "recording"; type: "bool" }
        }
        Method { name: "check" }
        Method {
            name: "toggle"
            Parameter { name: "savePath"; type: "QString" }
        }
        Method {
            name: "toggleRegion"
            Parameter { name: "region"; type: "QString" }
            Parameter { name: "sound"; type: "bool" }
            Parameter { name: "savePath"; type: "QString" }
        }
        Method {
            name: "toggleFullscreen"
            Parameter { name: "savePath"; type: "QString" }
        }
    }
    Component {
        file: "screenshot.rs"
        name: "ImpulseColorPicker"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["Impulse/ColorPicker 1.0"]
        isCreatable: false
        isSingleton: true
        exportMetaObjectRevisions: [256]
        Method { name: "pick" }
        Method {
            name: "pickOnceHidden"
            Parameter { name: "window"; type: "QObject"; isPointer: true }
        }
    }
    Component {
        file: "screenshot.rs"
        name: "ImpulseMangoHud"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["Impulse/MangoHud 1.0"]
        isCreatable: false
        isSingleton: true
        exportMetaObjectRevisions: [256]
        Method {
            name: "setFpsLimit"
            type: "bool"
            Parameter { name: "fps"; type: "double" }
        }
    }
}
