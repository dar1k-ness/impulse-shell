import QtQuick.tooling 1.2

// Impulse/ShellControl: what the shell's QML asks of the shell itself, implemented natively by
// ri (crates/qml/src/shellcontrol.rs). Not generated by qmltyperegistrar: there is no C++
// behind it.
Module {
    Component {
        file: "shellcontrol.rs"
        name: "ImpulseShellControl"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["Impulse/ShellControl 1.0"]
        isCreatable: false
        isSingleton: true
        exportMetaObjectRevisions: [256]
        // Calls `function` of the shell's IpcHandler `target`, as `qs ipc call` does.
        Method {
            name: "ipcCall"
            Parameter { name: "target"; type: "QString" }
            Parameter { name: "functionName"; type: "QString" }
        }
        // Shows the app window of QML file `file` (settings.qml, welcome.qml, killDialog.qml):
        // opens it, or focuses the one already open.
        Method {
            name: "openWindow"
            Parameter { name: "file"; type: "QString" }
        }
    }
}
