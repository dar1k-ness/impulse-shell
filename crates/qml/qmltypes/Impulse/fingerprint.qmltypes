import QtQuick.tooling 1.2

// Impulse/Fingerprint: fprintd over the system bus, implemented natively by ri
// (crates/qml/src/fprint.rs). Not generated by qmltyperegistrar: there is no C++ behind it.
Module {
    Component {
        file: "fprint.rs"
        name: "ImpulseFingerprint"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["Impulse/Fingerprint 1.0"]
        isCreatable: false
        isSingleton: true
        exportMetaObjectRevisions: [256]
        Property { name: "enrolled"; type: "bool"; isReadonly: true; notify: "enrolledChanged" }
        Signal { name: "enrolledChanged" }
        Signal { name: "available" }
        Method { name: "waitForAvailable" }
        Method { name: "cancelWait" }
    }
}
