import QtQuick.tooling 1.2

// Impulse/DisplayBrightness: the backlight (sysfs, logind) and DDC/CI monitors (i2c),
// implemented natively by ri (crates/qml/src/brightness.rs). Not generated by
// qmltyperegistrar: there is no C++ behind it.
Module {
    Component {
        file: "brightness.rs"
        name: "ImpulseDisplayBrightness"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["Impulse/DisplayBrightness 1.0"]
        isCreatable: false
        isSingleton: true
        exportMetaObjectRevisions: [256]
        Signal {
            name: "ddcDetected"
            Parameter { name: "monitors"; type: "QVariantList" }
        }
        Signal {
            name: "levelRead"
            Parameter { name: "monitor"; type: "QObject"; isPointer: true }
            Parameter { name: "ok"; type: "bool" }
            Parameter { name: "current"; type: "double" }
            Parameter { name: "max"; type: "double" }
        }
        Signal {
            name: "backlightChanged"
            Parameter { name: "current"; type: "double" }
            Parameter { name: "max"; type: "double" }
        }
        Method { name: "detectDdc" }
        Method {
            name: "readBacklight"
            Parameter { name: "monitor"; type: "QObject"; isPointer: true }
        }
        Method {
            name: "readDdc"
            Parameter { name: "monitor"; type: "QObject"; isPointer: true }
            Parameter { name: "busNum"; type: "QString" }
        }
        Method {
            name: "setBacklight"
            Parameter { name: "fraction"; type: "double" }
        }
        Method {
            name: "setDdc"
            Parameter { name: "busNum"; type: "QString" }
            Parameter { name: "fraction"; type: "double" }
            Parameter { name: "rawMax"; type: "double" }
        }
    }
}
