import QtQuick.tooling 1.2

// Sending the shell's own notifications, and what its notification list needs from our
// notification server beyond Rustshell's NotificationServer; implemented natively by ri (crates/qml/src/notifier.rs).
// Not generated by qmltyperegistrar: there is no C++ behind it.
Module {
    Component {
        file: "notifier.rs"
        name: "ImpulseNotify"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["Impulse/Notify 1.0"]
        isCreatable: false
        isSingleton: true
        exportMetaObjectRevisions: [256]
        // An action button of a notification was pressed: `id` is what `send` returned for
        // it, `index` counts its `actions` from 0.
        Signal {
            name: "actionInvoked"
            Parameter { name: "id"; type: "int" }
            Parameter { name: "index"; type: "int" }
        }
        // Notification `id` of our notification server (`Notification.id`) was sent again by
        // its sender (`replaces_id`). Rustshell's NotificationServer only shows that as
        // property changes of the same Notification.
        Signal {
            name: "notificationReplaced"
            Parameter { name: "id"; type: "int" }
        }
        // Deletes the copy our notification server keeps on disk for an `image` source, so
        // that a notification restored from the history after a restart still has its image.
        Method {
            name: "forgetImage"
            Parameter { name: "source"; type: "QString" }
        }
        // Shows a notification and returns the id of this send. `options` may be left out;
        // its fields: `appName` (string, "Shell" by default), `critical` (bool), `transient`
        // (bool), `actions` (list of button labels).
        Method {
            name: "send"
            type: "int"
            Parameter { name: "summary"; type: "QString" }
            Parameter { name: "body"; type: "QString" }
            Parameter { name: "options"; type: "QVariant" }
        }
    }
}
