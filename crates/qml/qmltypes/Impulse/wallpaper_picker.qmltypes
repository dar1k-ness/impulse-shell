import QtQuick.tooling 1.2

// Opens the wallpaper file dialog in the Pictures wallpaper folder and prints the chosen path.
// A Process whose work is native (crates/qml/src/procs.rs): `running`, `exited`, `stdout` as Process.
Module {
    Component {
        file: "procs.rs"
        name: "ImpulseWallpaperPicker"
        accessSemantics: "reference"
        prototype: "Process"
        exports: ["Impulse/WallpaperPicker 1.0"]
        exportMetaObjectRevisions: [256]
    }
}
