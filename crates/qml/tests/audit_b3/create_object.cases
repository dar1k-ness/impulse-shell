# Component.createObject(parent, properties): a value its property refuses makes no object.
# Qt 6.12 writes each initial property as QQmlProperty::write does (qqmlcomponent.cpp,
# QQmlComponentPrivate::setInitialProperty), warns "Could not set initial property NAME",
# completes the object, deletes it and returns null.
@property Component comp: Component { QtObject { property url u; property string s; property var v; property int i; property color c; property point p; property date d; property real r; property bool b; property font f; property list<int> li; property QtObject o } }
