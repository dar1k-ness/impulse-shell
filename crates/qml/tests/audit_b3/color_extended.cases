@property color c
@property color d: "red"
@property var vc
@property int nc: 0
@onCChanged: nc += 1
w(function(){ c = "red"; c.r = 2; return [c, c.r, c.g, c.b, c.a, c.valid, c.hsvHue, c.hsvSaturation, c.hsvValue, c.hslHue, c.hslSaturation, c.hslLightness].join("|") })
=> string:#ff0000|2|0|0|1|true|0|1|1|0|1|0.5000076293945312
w(function(){ return [c == d, c === d, Qt.colorEqual(c, d), Qt.colorEqual(c, "red"), c == "#ff0000", String(c) == String(d)].join("|") })
=> string:false|false|false|false|true|true
w(function(){ var n = nc; c = "red"; var m = nc; c = "red"; return (m - n) + "|" + (nc - m) + "|" + (c == d) })
=> string:1|0|true
w(function(){ c = "red"; c.r = 1.5; var n = nc; c.r = 1.5; var m = nc; c.r = 0.5; return (m - n) + "|" + (nc - m) + "|" + c + "|" + c.r + "|" + (c == Qt.rgba(0.5, 0, 0, 1)) })
=> string:0|1|#800000|0.5|false
