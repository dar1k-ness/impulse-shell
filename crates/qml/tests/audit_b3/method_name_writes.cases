# a write to a method name of a value type
(function(){ var v = Qt.vector3d(1, 2, 3); v.dotProduct = 5; return String(v) })()
=> string:QVector3D(1, 2, 5)
(function(){ var v = Qt.vector3d(1, 2, 3); v.crossProduct = 5; return String(v) })()
=> string:QVector3D(1, 5, 3)
(function(){ var v = Qt.vector3d(1, 2, 3); v.toString = 5; return String(v) })()
=> string:QVector3D(5, 2, 3)
(function(){ var v = Qt.vector3d(1, 2, 3); v.dotProduct = "7"; return String(v) })()
=> string:QVector3D(1, 2, 7)
(function(){ var v = Qt.vector3d(1, 2, 3); try { v.dotProduct = {}; return String(v) } catch (e) { return String(e) } })()
=> string:QVector3D(1, 2, nan)
