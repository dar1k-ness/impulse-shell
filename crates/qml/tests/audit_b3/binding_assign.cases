@property vector3d v
@property point p
@property font f
@property url u
@property date d
@property string s
@property real k: 2
w(function(){ v = Qt.binding(function() { return Qt.vector3d(k, 2, 3) }); k = 5; return v })
=> object:QVector3D(5, 2, 3)
w(function(){ p = Qt.binding(function() { return Qt.point(k, 2) }); k = 6; return p })
=> object:QPointF(6, 2)
w(function(){ f = Qt.binding(function() { return Qt.font({pixelSize: k}) }); k = 7; return f.pixelSize })
=> number:7
w(function(){ u = Qt.binding(function() { return "http://a/" + k }); k = 8; return u })
=> object:http://a/8
w(function(){ s = Qt.binding(function() { return "s" + k }); k = 9; return s })
=> string:s9
w(function(){ d = Qt.binding(function() { return new Date(k) }); k = 10; return d.getTime() })
=> number:10
