# Every pair of twenty properties and twenty values as an initial property of
# Component.createObject: `refused` where Qt 6.12 made no object. property_write_matrix
# holds the same pairs as plain writes, which follow another rule.
@property Component comp: Component { QtObject { property url u; property string s; property var v; property int i; property color c; property point p; property date d; property real r; property bool b; property font f; property list<int> li; property QtObject o } }
@property Component ic: Component { Item { } }
@property Component tc: Component { Text { } }
@property Component rec: Component { Rectangle { } }
@property Component tmc: Component { Timer { } }
@function rd(o, k) { if (!o) return "refused"; var x = o[k]; return x === root ? "root" : (x === null ? "null" : typeof x) + ":" + (k === "d" && x ? x.getTime() : k === "f" ? x.family : x) }
