@property font g
w(function(){ g = "Arial,12,-1,5,400,0,0,0,0,0,0,0,3,4,0,1"; return String(g) })
=> string:QFont(Arial,12,-1,5,400,0,0,0,0,0,0,0,3,4,0,1,,0,0)
w(function(){ g = "Arial,12,-1,5,400,0,0,0,0,0,0,0,3,4,0,1"; g.wordSpacing = 5; return String(g) })
=> string:QFont(Arial,12,-1,5,400,0,0,0,0,0,0,0,3,5,0,1,,0,0)
w(function(){ g = "Arial,12,-1,5,400,0,0,0,0,0,0,0,3,4,0,1"; g.bold = true; return String(g) })
=> string:QFont(Arial,12,-1,5,700,0,0,0,0,0,0,0,3,4,0,1,,0,0)
w(function(){ g = "Arial,12,-1,5,400,2,0,0,1,0,0,0,3,4,0,1"; g.bold = true; return String(g) })
=> string:QFont(Arial,12,-1,5,700,2,0,0,1,0,0,0,3,4,0,1,,0,0)
@property font f
w(function(){ f.family = ["a", ["b", "c"]]; return f.family.length + "," + f.family.charCodeAt(0) + "," + f.family.charCodeAt(1) })
=> string:2,97,0
