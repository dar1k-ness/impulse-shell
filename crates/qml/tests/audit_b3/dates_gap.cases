# clock readings the clocks skip or show twice, read by QDateTime's formats
Date.parse("Mar 28 2010 02:30:00")
=> number:1269732600000
Date.parse("Sun Mar 28 02:30:00 2010")
=> number:1269732600000
Date.parse("Sun Mar 28 2010 02:30:00")
=> number:1269732600000
Date.parse("28 Mar 2010 02:30:00")
=> number:1269743400000
Date.parse("Sun, 28 Mar 2010 02:30:00")
=> number:1269743400000
Date.parse("3/28/2010 02:30")
=> number:1269732600000
Date.parse("2010-03-28 02:30:00")
=> number:1269732600000
Date.parse("2010-03-28 02:30")
=> number:1269732600000
Date.parse("Oct 31 2010 02:30:00")
=> number:1288477800000
Date.parse("Sun Oct 31 02:30:00 2010")
=> number:1288477800000
Date.parse("2010-10-31 02:30:00")
=> number:1288477800000
Date.parse("2010-10-31T02:30:00")
=> number:1288481400000
Date.parse("Oct 26 2014 01:30:00")
=> number:1414272600000
Date.parse("Sun Oct 26 01:30:00 2014")
=> number:1414272600000
Date.parse("Mar 27 2011 02:30:00")
=> number:1301182200000
Date.parse("Apr 1 1981 00:30:00")
=> number:354922200000
Date.parse("1981-04-01T00:30:00")
=> number:354918600000
Date.parse("Mar 28 2010 01:59:59")
=> number:1269730799000
Date.parse("Mar 28 2010 03:00:00")
=> number:1269730800000
new Date("Mar 28 2010 02:30:00").getHours()
=> number:3
new Date("Sun Mar 28 02:30:00 2010").toString()
=> string:Sun Mar 28 03:30:00 2010 GMT+0400
new Date(2010, 2, 28, 2, 30).toLocaleString(Qt.locale("C"), "yyyy-MM-dd HH:mm t")
=> string:2010-03-28 01:30 MSK
Qt.formatDateTime(new Date(2010, 2, 28, 2, 30), "yyyy-MM-dd hh:mm")
=> string:2010-03-28 01:30
Date.fromLocaleString(Qt.locale("C"), "2010-03-28 02:30", "yyyy-MM-dd hh:mm").getTime()
=> number:1269732600000
Date.fromLocaleString(Qt.locale("C"), "2010-10-31 02:30", "yyyy-MM-dd hh:mm").getTime()
=> number:1288477800000
