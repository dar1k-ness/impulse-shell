=> string:#0000ff true
w(function(){ c = "red"; c = Qt.hsva(0.5, 1, 1, 1); return c + " " + c.hsvHue })
=> string:#00ffff 0.5
w(function(){ c = "red"; var n = nc; c = "#ff0000"; var m = nc; c = "#f00"; return (m - n) + "|" + (nc - m) })
=> string:0|0
w(function(){ c = "red"; var n = nc; try { c = undefined } catch (e) {} var m = nc; try { c = "nope" } catch (e) {} return (m - n) + "|" + (nc - m) + "|" + c })
=> string:0|1|#000000
w(function(){ c = "red"; root.c = undefined; return c + " " + c.valid })
=> string:THROW Error: Cannot assign [undefined] to QColor
w(function(){ c = "red"; root["c"] = undefined; return c + " " + c.valid })
=> string:THROW Error: Cannot assign [undefined] to QColor
