#!/bin/bash
# rusty-impulse-default native|qt: make native rusty-impulse or Qt `qs -c ii` (the original, drawn by
# Quickshell; `qs -c rusty-impulse` where its tree is under that name) the shell Hyprland starts at login
# (execs.lua + the Ctrl+Super+R restart bind), then swap the running shell for it under
# /tmp/ii-bench.lock: lockscreen check before any kill, exact PIDs, never two shells at once.
# Config-only (no live swap): rusty-impulse-default native|qt --no-swap
set -u
mode=${1:-}; H=$HOME/.config/hypr/hyprland
case "$mode" in native|qt) ;; *) echo "usage: rusty-impulse-default native|qt [--no-swap]" >&2; exit 2;; esac
# The Qt shell is the Quickshell package (qs). Where it is not installed there is nothing to
# switch to: say so before any file or process is touched.
if [ $mode = qt ] && ! command -v qs >/dev/null 2>&1; then
  echo "rusty-impulse-default: Quickshell (qs) is not installed on this PC, there is no Qt shell to switch to; nothing changed" >&2; exit 1
fi
# The Qt shell is the original, which Quickshell reads from ~/.config/quickshell/NAME as qs -c NAME,
# not the tree install.sh puts for the native shell (~/.config/rustshell/rusty-impulse). NAME is
# ii, the name it always had and the one a PC switched from the old build keeps; where there is
# no such tree, one put there under the new name is taken. Quickshell has neither the Impulse nor
# the Rustshell module: a tree that imports them ends at once with 'module "Impulse" is not
# installed'. Look before the native shell is stopped.
QS_NAME=
if [ $mode = qt ]; then
  why=
  for n in ii rusty-impulse; do
    d=${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/$n
    [ -f "$d/shell.qml" ] || { why+=" no shell.qml in $d;"; continue; }
    f=$(grep -rlE --include='*.qml' '^import (Impulse|Rustshell)([ .]|$)' "$d/" 2>/dev/null | head -1)
    [ -z "$f" ] || { why+=" the tree in $d imports modules only the native shell has (first file: $f);"; continue; }
    QS_NAME=$n; break
  done
  [ -n "$QS_NAME" ] || { echo "rusty-impulse-default: there is no tree Quickshell can draw:$why nothing changed" >&2; exit 1; }
fi
QT_START="qs -c $QS_NAME"; NAT_START='$HOME/.local/bin/rusty-impulse-shell'
# A Qt start line whatever config it names: qs -c $qsConfig is what this script wrote before, and
# $qsConfig is the native shell's config since the rename.
QT_ANY='qs -c [A-Za-z0-9_$-]*'
# setstart TO: the shell start line of the autostart and of the Ctrl+Super+R bind.
setstart() {
  local was
  for was in "$QT_ANY" "$NAT_START"; do
    sed -i "s|hl.exec_cmd(\"$was\")|hl.exec_cmd(\"$1\")|" $H/execs.lua
    sed -i "s|killall ydotool qs quickshell rusty-impulse; $was|killall ydotool qs quickshell rusty-impulse; $1|" $H/keybinds.lua
  done
}
if [ $mode = native ]; then to=$NAT_START; else to=$QT_START; fi
was_native=; grep -qF "hl.exec_cmd(\"$NAT_START\")" $H/execs.lua && was_native=1
setstart "$to"
grep -qF "hl.exec_cmd(\"$to\")" $H/execs.lua || { echo "ERROR: execs.lua has no shell start line" >&2; exit 1; }
echo "autostart: $mode ($to)"
[ "${2:-}" = --no-swap ] && exit 0

U=$(id -u); export XDG_RUNTIME_DIR=/run/user/$U DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$U/bus
export HYPRLAND_INSTANCE_SIGNATURE=$(ls -t $XDG_RUNTIME_DIR/hypr | head -1)
[ -n "${WAYLAND_DISPLAY-}" ] || export WAYLAND_DISPLAY=$(ls $XDG_RUNTIME_DIR | grep -m1 -E '^wayland-[0-9]+$')
# Is the shell answering? Each is asked with its own client and by its own name: qs -c NAME the
# original, rusty-impulse -c rusty-impulse the native shell (no qs needed). So with its bar: the
# original's layers are quickshell:*, the native shell's rustshell:*.
ipc_ok() {
  if [ $mode = qt ]; then timeout 3 $QT_START ipc show >/dev/null 2>&1
  else timeout 3 $HOME/.local/bin/rusty-impulse -c rusty-impulse ipc show >/dev/null 2>&1; fi
}
bar_up() { local ns=rustshell; [ $mode = qt ] && ns=quickshell; hyprctl layers | grep -q "$ns:bar"; }
# The rollback watch (rollback-watch) ends by itself once it sees the Qt shell up. Where it runs
# now, or is set to start at login, it is started again when the shell is the native one again:
# a switch to Qt that failed must not leave the native shell without it. A watch started by hand
# (rollback-watch start, no unit) is found again after a switch to Qt that worked by the path
# written down then, until the next login.
WUNIT=rusty-impulse-rollback-watch.service WSAVED=$XDG_RUNTIME_DIR/rusty-impulse-default.watch
watch_path() {
  local p; p=$(cat $XDG_RUNTIME_DIR/rusty-impulse-rollback-watch.pid 2>/dev/null) || return 0
  [ -n "$p" ] && tr '\0' '\n' < /proc/$p/cmdline 2>/dev/null | grep -m1 '/rollback-watch$'
}
watch=$(watch_path); [ -n "$watch" ] || { watch=$(cat $WSAVED 2>/dev/null); [ -x "$watch" ] || watch=; }
watch_again() {
  [ -n "$watch" ] || systemctl --user -q is-enabled $WUNIT 2>/dev/null || return 0
  sleep 2 # a watch that saw the Qt shell is on its way out
  [ -z "$(watch_path)" ] || return 0
  if systemctl --user -q is-enabled $WUNIT 2>/dev/null; then systemctl --user start $WUNIT; sleep 2
  else "$watch" start >/dev/null 2>&1; fi
  if [ -n "$(watch_path)" ]; then echo "rollback watch: started again"; rm -f $WSAVED
  else echo "ERROR: the rollback watch is not running and did not start again: ${watch:-systemctl --user start $WUNIT}"; fi
}
islocked() {
  for s in $(loginctl list-sessions --no-legend | awk '{print $1}'); do
    [ "$(loginctl show-session $s -p Type --value)" = wayland ] && [ "$(loginctl show-session $s -p LockedHint --value)" = yes ] && return 0
  done
  hyprctl monitors | grep -q 'workspace: 2147483647' && return 0; return 1
}
shellpids() {
  for p in /proc/[0-9]*; do
    e=$(readlink $p/exe 2>/dev/null) || continue
    # A shell is the process named rusty-impulse, qs or quickshell: what rusty-impulse starts from its own
    # binary under another name (ri-childguard) is not a second shell.
    case "$(cat $p/comm 2>/dev/null)" in rusty-impulse|qs|quickshell) ;; *) continue;; esac
    case "$e" in /usr/bin/quickshell|*/rusty-impulse*) tr '\0' ' ' < $p/cmdline | grep -qE ' (ipc|msg|kill) |-p ' || basename $p;; esac
  done
}
want() { case "$(readlink /proc/$1/exe)" in */rusty-impulse|*"/rusty-impulse (deleted)") [ $mode = native ];; /usr/bin/quickshell) [ $mode = qt ];; *) false;; esac; }
swap() {
  local p cur ok=""
  cur=$(shellpids)
  for p in $cur; do want $p && ok=$p; done
  if [ -n "$ok" ] && [ "$(echo $cur | wc -w)" = 1 ]; then echo "already running: $ok $(readlink /proc/$ok/exe)"; return 0; fi
  islocked && { echo "ABORT: session locked, nothing killed"; return 1; }
  # exec_cmd can answer ok yet spawn nothing (E2BIG env): prove it works before killing anything
  local t=/tmp/rusty-impulse-default.exec.$$; rm -f $t
  hyprctl dispatch "hl.dsp.exec_cmd(\"touch $t\")" >/dev/null; sleep 1
  [ -e $t ] || { echo "ABORT: Hyprland exec_cmd spawns nothing, shell left as is"; return 1; }; rm -f $t
  if [ -n "$cur" ]; then
    echo "stopping: $(for p in $cur; do echo -n "$p $(readlink /proc/$p/exe); "; done)"
    kill $cur; for i in $(seq 1 30); do [ -z "$(shellpids)" ] && break; sleep 0.2; done
    p=$(shellpids); [ -n "$p" ] && kill -9 $p; sleep 0.3
  fi
  for p in $(pgrep -x cava); do [ "$(ps -o ppid= -p $p | tr -d ' ')" = 1 ] && kill -9 $p; done
  if [ $mode = native ]; then hyprctl dispatch 'hl.dsp.exec_cmd("$HOME/.local/bin/rusty-impulse-shell")' >/dev/null
  else hyprctl dispatch "hl.dsp.exec_cmd(\"$QT_START\")" >/dev/null; fi
  # 20 s, less than the 30 s (QT_WAIT) rollback-watch gives a Qt shell before it puts the
  # previous build back: a Qt shell that draws nothing must be given up here first.
  local up="" t0=$SECONDS
  for i in $(seq 1 60); do
    sleep 0.5; ok=""; for p in $(shellpids); do want $p && ok=$p; done
    [ -n "$ok" ] && ipc_ok && bar_up && { up=1; break; }
    [ $mode = qt ] && [ $((SECONDS - t0)) -ge 20 ] && break
    # qs that cannot load its tree ends in the first second: no use waiting the rest.
    [ $mode = qt ] && [ -z "$ok" ] && [ $i -ge 10 ] && break
  done
  [ -n "$up" ] || { echo "ERROR: $mode shell did not start${ok:+ (pid $ok runs but does not answer or draws no bar)}"; return 1; }
  echo "running: $ok $(readlink /proc/$ok/exe)"
}
# The Qt shell did not come: the choice goes back to native and the native shell is started
# again, so neither this session nor the next login is left without a shell.
back_to_native() {
  local p
  setstart "$NAT_START"
  echo "autostart: back to native ($NAT_START)"
  mode=native
  for p in $(shellpids); do want $p || kill $p 2>/dev/null; done
  for p in $(shellpids); do want $p && { echo "running: $p $(readlink /proc/$p/exe)"; return 0; }; done
  hyprctl dispatch 'hl.dsp.exec_cmd("$HOME/.local/bin/rusty-impulse-shell")' >/dev/null
  for i in $(seq 1 30); do
    sleep 0.5; for p in $(shellpids); do want $p && { echo "running again: $p $(readlink /proc/$p/exe)"; return 0; }; done
  done
  echo "ERROR: the native shell did not start again either: \$HOME/.local/bin/rusty-impulse-shell"
}
exec 9>/tmp/ii-bench.lock
flock -w 900 9 || { echo "ABORT: /tmp/ii-bench.lock busy"; exit 1; }
systemd-inhibit --what=idle --who=rusty-impulse-default --why="shell swap" sleep 120 9>&- & INH=$!
swap; rc=$?
[ $rc = 0 ] || [ $mode != qt ] || [ -z "$was_native" ] || back_to_native
# mode is native here unless the Qt shell is up
if [ $mode = native ]; then watch_again; elif [ -n "$watch" ]; then echo "$watch" > $WSAVED; fi
kill $INH 2>/dev/null
exit $rc
