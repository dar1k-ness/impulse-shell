import QtQuick
import QtQuick.Layouts
import Rustshell
import Rustshell.Io
import Impulse
import ri.services
import ri.modules.common
import ri.modules.common.widgets
import ri.modules.common.functions

SettingsPage {
    id: page

    // Colors are generated by the shared Switchwall queue; every window fades to them when its
    // process applies them (MaterialThemeLoader), the click itself shows at once
    function regenerateColors(request) {
        Switchwall.run(Object.assign({ noSwitch: true }, request));
    }

    Connections {
        target: Switchwall
        // The tile follows the colors file again once it has been read after the last run
        function onSettled() {
            page.pendingMode = "";
        }
    }

    // The picked tile is selected at once; darkmode itself follows when the new colors load
    property string pendingMode: ""
    readonly property bool shownDark: pendingMode !== "" ? pendingMode === "dark" : Appearance.m3colors.darkmode

    function setThemeMode(mode) {
        Config.options.appearance.autoDarkMode = mode === "auto";
        if (mode === "auto")
            return;
        page.pendingMode = mode;
        page.regenerateColors({ mode: mode });
    }

    // The scheme type goes to the run directly: it must not wait for config.json to be written
    function setPalette(type) {
        Config.options.appearance.palette.type = type;
        page.regenerateColors({ schemeType: type, mode: page.shownDark ? "dark" : "light" });
    }

    RandomWallpaper {
        id: randomWallProc
    }

    component ThemeMock: Rectangle {
        property bool dark: false
        anchors.fill: parent
        color: dark ? "#1d1f24" : "#f4f5f9"
        Rectangle {
            x: 8
            y: 8
            width: parent.width - 16
            height: 5
            radius: 3
            color: parent.dark ? "#3a3d45" : "#dfe1e8"
        }
        Rectangle {
            x: 14
            y: 20
            width: parent.width * 0.55
            height: parent.height - 30
            radius: 5
            color: parent.dark ? "#2c2f36" : "#e4e6ee"
            Rectangle {
                x: 6
                y: 8
                width: 22
                height: 5
                radius: 3
                color: Appearance.colors.colPrimary
            }
        }
        Rectangle {
            x: parent.width * 0.55 + 20
            y: 20
            width: parent.width * 0.45 - 34
            height: parent.height - 30
            radius: 5
            color: parent.dark ? "#2c2f36" : "#e4e6ee"
        }
    }

    component AccentSwatch: ColumnLayout {
        id: swatch
        required property string value
        required property string label
        required property color c1
        required property color c2
        required property color c3
        readonly property bool selected: Config.options.appearance.palette.type === swatch.value
        spacing: 6

        Item {
            Layout.alignment: Qt.AlignHCenter
            implicitWidth: 56
            implicitHeight: 56
            Rectangle {
                anchors.fill: parent
                radius: width / 2
                color: "transparent"
                border.width: 2
                border.color: swatch.selected ? Appearance.colors.colPrimary : (swatchMouse.containsMouse ? Appearance.colors.colOutlineVariant : "transparent")
            }
            Item {
                id: dot
                anchors.centerIn: parent
                width: 44
                height: 44
                scale: swatchMouse.pressed ? 0.9 : 1
                Behavior on scale {
                    animation: Appearance.animation.elementMoveFast.numberAnimation.createObject(this)
                }
                // Quarters are clipped by plain Items: a Rectangle's clip ignores its radius
                Item {
                    width: parent.width
                    height: parent.height / 2
                    clip: true
                    Rectangle {
                        width: dot.width
                        height: dot.height
                        radius: width / 2
                        color: swatch.c1
                    }
                }
                Item {
                    y: parent.height / 2
                    width: parent.width / 2
                    height: parent.height / 2
                    clip: true
                    Rectangle {
                        y: -dot.height / 2
                        width: dot.width
                        height: dot.height
                        radius: width / 2
                        color: swatch.c2
                    }
                }
                Item {
                    x: parent.width / 2
                    y: parent.height / 2
                    width: parent.width / 2
                    height: parent.height / 2
                    clip: true
                    Rectangle {
                        x: -dot.width / 2
                        y: -dot.height / 2
                        width: dot.width
                        height: dot.height
                        radius: width / 2
                        color: swatch.c3
                    }
                }
            }
            Rectangle {
                visible: swatch.value === "auto"
                anchors {
                    right: parent.right
                    bottom: parent.bottom
                }
                width: 20
                height: 20
                radius: 10
                color: Appearance.colors.colPrimary
                StyledText {
                    anchors.centerIn: parent
                    text: "A"
                    font.pixelSize: 11
                    font.weight: Font.Bold
                    color: Appearance.colors.colOnPrimary
                }
            }
            MouseArea {
                id: swatchMouse
                anchors.fill: parent
                hoverEnabled: true
                cursorShape: Qt.PointingHandCursor
                onClicked: page.setPalette(swatch.value)
            }
        }
        StyledText {
            Layout.alignment: Qt.AlignHCenter
            Layout.minimumWidth: 64
            Layout.leftMargin: 6
            Layout.rightMargin: 6
            horizontalAlignment: Text.AlignHCenter
            text: swatch.label
            font.pixelSize: Appearance.font.pixelSize.smallie
            color: swatch.selected ? Appearance.colors.colPrimary : Appearance.colors.colOnLayer2
        }
    }

    SettingsGroup {
        title: Translation.tr("Wallpaper & theme")

        SettingsCard {
            // The theme tiles sit beside the wallpaper while both fit in the card, else under it.
            // The card's width, not the grid's: a layout is capped at its maximum width, here
            // one column's while every child is fixed.
            GridLayout {
                Layout.fillWidth: true
                columns: wallpaperColumn.implicitWidth + columnSpacing + themeTiles.implicitWidth <= parent.width ? 2 : 1
                columnSpacing: 22
                rowSpacing: 16

                ColumnLayout {
                    id: wallpaperColumn
                    spacing: 12
                    Item {
                        implicitWidth: 268
                        implicitHeight: 150
                        SettingsWallpaperThumb {}
                    }
                    // Picking a file and the random sources are one choice: they share a row
                    RowLayout {
                        spacing: 8
                        RippleButtonWithIcon {
                            materialIcon: "folder_open"
                            mainText: Translation.tr("Change")
                            buttonRadius: Appearance.rounding.full
                            colBackground: Appearance.colors.colPrimaryContainer
                            colBackgroundHover: Appearance.colors.colPrimaryContainerHover
                            colText: Appearance.colors.colOnPrimaryContainer
                            onClicked: Switchwall.pick()
                            StyledToolTip {
                                text: Translation.tr("Pick wallpaper image on your system")
                            }
                        }
                        Repeater {
                            model: Config.options.policies.weeb === 1 ? [
                                { label: "Konachan", source: "konachan", tip: Translation.tr("Random SFW Anime wallpaper from Konachan\nImage is saved to ~/Pictures/Wallpapers") },
                                { label: "osu!", source: "osu", tip: Translation.tr("Random osu! seasonal background\nImage is saved to ~/Pictures/Wallpapers") }
                            ] : []
                            RippleButtonWithIcon {
                                required property var modelData
                                enabled: !randomWallProc.running
                                materialIcon: "ifl"
                                mainText: randomWallProc.running && randomWallProc.source === modelData.source ? Translation.tr("Be patient...") : modelData.label
                                buttonRadius: Appearance.rounding.full
                                colBackground: Appearance.colors.colLayer3
                                colBackgroundHover: Appearance.colors.colLayer3Hover
                                onClicked: {
                                    randomWallProc.source = modelData.source;
                                    randomWallProc.running = true;
                                }
                                StyledToolTip {
                                    text: modelData.tip
                                }
                            }
                        }
                    }
                    RippleButtonWithIcon {
                        enabled: !Wallpick.busy
                        materialIcon: "wallpaper_slideshow"
                        mainText: Wallpick.busy ? Translation.tr("Looking...") : Translation.tr("Pick for me")
                        buttonRadius: Appearance.rounding.full
                        colBackground: Appearance.colors.colLayer3
                        colBackgroundHover: Appearance.colors.colLayer3Hover
                        // The picker asks what to go by before it looks
                        onClicked: wallpickAsk.visible = !wallpickAsk.visible
                        StyledToolTip {
                            text: Translation.tr("Find a wallpaper that matches your taste on Wallhaven or Konachan\nImage is saved to ~/Pictures/Wallpapers")
                        }
                    }
                    WallpickAsk {
                        id: wallpickAsk
                        visible: false
                        Layout.preferredWidth: 268
                        Layout.maximumWidth: 268
                        onAsked: visible = false
                    }
                    StyledText {
                        visible: Wallpick.status.length > 0
                        Layout.maximumWidth: 268
                        elide: Text.ElideRight
                        text: Wallpick.status
                        color: Wallpick.failed ? Appearance.colors.colError : Appearance.colors.colSubtext
                        font.pixelSize: Appearance.font.pixelSize.smaller
                    }
                }

                ColumnLayout {
                    Layout.alignment: Qt.AlignTop
                    Layout.fillWidth: true
                    spacing: 10
                    StyledText {
                        text: Translation.tr("Theme")
                        color: Appearance.colors.colOnLayer2
                        font.pixelSize: Appearance.font.pixelSize.small
                        font.weight: Font.Medium
                    }
                    RowLayout {
                        id: themeTiles
                        spacing: 4
                        SettingsPreviewTile {
                            label: Translation.tr("Light")
                            icon: "light_mode"
                            tileWidth: 96
                            tileHeight: 62
                            selected: !Config.options.appearance.autoDarkMode && !page.shownDark
                            onClicked: page.setThemeMode("light")
                            ThemeMock {
                                radius: Appearance.rounding.small
                            }
                        }
                        SettingsPreviewTile {
                            label: Translation.tr("Dark")
                            icon: "dark_mode"
                            tileWidth: 96
                            tileHeight: 62
                            selected: !Config.options.appearance.autoDarkMode && page.shownDark
                            onClicked: page.setThemeMode("dark")
                            ThemeMock {
                                dark: true
                                radius: Appearance.rounding.small
                            }
                        }
                        SettingsPreviewTile {
                            label: Translation.tr("Auto")
                            icon: "brightness_auto"
                            tileWidth: 96
                            tileHeight: 62
                            selected: Config.options.appearance.autoDarkMode
                            onClicked: page.setThemeMode("auto")
                            ThemeMock {
                                radius: Appearance.rounding.small
                            }
                            Item {
                                x: parent.width / 2
                                width: parent.width / 2
                                height: parent.height
                                clip: true
                                ThemeMock {
                                    anchors.fill: undefined
                                    x: -parent.x
                                    width: 96
                                    height: 62
                                    dark: true
                                }
                            }
                        }
                    }
                    StyledText {
                        Layout.fillWidth: true
                        visible: Config.options.appearance.autoDarkMode
                        text: Translation.tr("Dark from %1 to %2").arg(Config.options.light.night.from).arg(Config.options.light.night.to)
                        color: Appearance.colors.colSubtext
                        font.pixelSize: Appearance.font.pixelSize.smallie
                        wrapMode: Text.Wrap
                    }
                }
            }
        }
    }

    SettingsGroup {
        title: Translation.tr("Colors")

        SettingsCard {
            StyledText {
                text: Translation.tr("Accent color")
                color: Appearance.colors.colOnLayer2
                font.pixelSize: Appearance.font.pixelSize.small
                font.weight: Font.Medium
            }
            StyledText {
                Layout.topMargin: -9
                text: Translation.tr("Picked from the wallpaper. Each style mixes it differently")
                color: Appearance.colors.colSubtext
                font.pixelSize: Appearance.font.pixelSize.smallie
            }
            // Each swatch is as wide as its label: the row packs from the left like the theme
            // tiles and wraps only when the window is too narrow for all of them
            Flow {
                Layout.fillWidth: true
                Layout.topMargin: 4
                spacing: 4
                Repeater {
                    model: [
                        { value: "auto", label: Translation.tr("Auto"), c1: "", c2: "", c3: "" },
                        { value: "scheme-tonal-spot", label: Translation.tr("Tonal spot"), c1: "#a8b8d8", c2: "#9aa3b5", c3: "#c4a8d8" },
                        { value: "scheme-content", label: Translation.tr("Content"), c1: "#8fb2e8", c2: "#93a4c8", c3: "#b9a0dc" },
                        { value: "scheme-expressive", label: Translation.tr("Expressive"), c1: "#b7dc8f", c2: "#8f9fe0", c3: "#e08fc4" },
                        { value: "scheme-fidelity", label: Translation.tr("Fidelity"), c1: "#86b4f0", c2: "#9aa9c7", c3: "#c39ad8" },
                        { value: "scheme-fruit-salad", label: Translation.tr("Fruit salad"), c1: "#8fe0c8", c2: "#86c8b4", c3: "#8fb0e0" },
                        { value: "scheme-rainbow", label: Translation.tr("Rainbow"), c1: "#9fb2e0", c2: "#a8b0c4", c3: "#c9a3dc" },
                        { value: "scheme-neutral", label: Translation.tr("Neutral"), c1: "#b8bcc4", c2: "#a9adb4", c3: "#c7b8c4" },
                        { value: "scheme-monochrome", label: Translation.tr("Mono"), c1: "#d6d6d6", c2: "#9a9a9a", c3: "#bdbdbd" }
                    ]
                    AccentSwatch {
                        required property var modelData
                        value: modelData.value
                        label: modelData.label
                        c1: modelData.value === "auto" ? Appearance.m3colors.m3primary : modelData.c1
                        c2: modelData.value === "auto" ? Appearance.m3colors.m3secondary : modelData.c2
                        c3: modelData.value === "auto" ? Appearance.m3colors.m3tertiary : modelData.c3
                    }
                }
            }
        }
        SettingsSwitchRow {
            title: Translation.tr("Transparency")
            subtitle: Translation.tr("Panels let the wallpaper show through")
            checked: Config.options.appearance.transparency.enable
            onUserToggled: value => Config.options.appearance.transparency.enable = value
        }
    }

    SettingsGroup {
        title: Translation.tr("Bar & screen")

        SettingsCard {
            StyledText {
                text: Translation.tr("Bar position")
                color: Appearance.colors.colOnLayer2
                font.pixelSize: Appearance.font.pixelSize.small
                font.weight: Font.Medium
            }
            RowLayout {
                Layout.topMargin: 6
                spacing: 8
                SettingsBarPositionTile { position: 0; label: Translation.tr("Top") }
                SettingsBarPositionTile { position: 1; label: Translation.tr("Bottom") }
                SettingsBarPositionTile { position: 2; label: Translation.tr("Left") }
                SettingsBarPositionTile { position: 3; label: Translation.tr("Right") }
            }
        }
        SettingsSegmentedRow {
            title: Translation.tr("Bar style")
            currentValue: Config.options.bar.cornerStyle
            onSelected: value => Config.options.bar.cornerStyle = value
            options: [
                { label: Translation.tr("Hug"), value: 0 },
                { label: Translation.tr("Float"), value: 1 },
                { label: Translation.tr("Rect"), value: 2 }
            ]
        }
        SettingsSegmentedRow {
            title: Translation.tr("Screen corners")
            currentValue: Config.options.appearance.fakeScreenRounding
            onSelected: value => Config.options.appearance.fakeScreenRounding = value
            options: [
                { label: Translation.tr("Square"), value: 0 },
                { label: Translation.tr("Round"), value: 1 },
                { label: Translation.tr("Not in fullscreen"), value: 2 }
            ]
        }
    }
}
